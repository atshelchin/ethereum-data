              "visible": "always"
            },
            {
              "path": "deadline",
              "label": "Deadline",
              "format": "date",
              "params": {
                "encoding": "timestamp"
              },
              "visible": "always"
            }
          ],
          "interpolatedIntent": "Cancel TP/SL {tpslGroupId}"
        }
      }
    }
